# 仅供本机 Docker 开发环境使用；复制为 .env 后按需修改。
POSTGRES_DB=oxide_blog
POSTGRES_USER=oxide
POSTGRES_PASSWORD=oxide_dev_password
POSTGRES_PORT=15432

REDIS_PASSWORD=oxide_dev_password
REDIS_PORT=16379

# 在宿主机运行 Rust 程序时使用；容器内迁移由 Compose 注入容器地址。
DATABASE_URL=postgres://oxide:oxide_dev_password@127.0.0.1:15432/oxide_blog
REDIS_URL=redis://:oxide_dev_password@127.0.0.1:16379/0

# Axum 仅监听本机；生产环境由部署配置覆盖。
APP_BIND=127.0.0.1:3001
DATABASE_MAX_CONNECTIONS=10
RUST_LOG=rust_oxide=info,tower_http=info

# 首次启动可用以下凭据创建唯一管理员；创建后删除密码配置。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password
# 生产环境必须替换为随机密钥；更换后旧评论头像标识变化，已保存的 OSS/Agent 凭据需重新录入。
COMMENT_HASH_KEY=replace-with-a-long-random-secret
SESSION_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:3000
SEARCH_INDEX_DIR=./data/search-index

# 文件型 Agent Skill 包与独立启停状态；部署时持久化挂载，不存数据库。
AGENT_SKILLS_DIR=./data/agent-skills

# Agent 工具的非敏感配置（单实例写入，需持久化）；密钥只通过环境注入。
AGENT_TOOLS_CONFIG=./data/agent-tools.json
# WEB_SEARCH_API_KEY=replace-with-your-bigmodel-api-key

# 可选：Notion 集成密钥。将目标页面共享给该集成后，可在后台手动导入和同步。
# NOTION_API_KEY=secret_...

# 可选：微信支付 Native 扫码订阅。全部填写后重启 API；未配置时付费文章仍锁定，但无法下单。
# 商户私钥和平台公钥使用服务器上的 PEM 文件路径，不提交到仓库。
# WECHAT_PAY_MCH_ID=your-merchant-id
# WECHAT_PAY_APP_ID=your-app-id
# WECHAT_PAY_MERCHANT_SERIAL=your-merchant-certificate-serial
# WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/path/to/apiclient_key.pem
# WECHAT_PAY_API_V3_KEY=exactly-32-bytes-secret-key-here
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=/path/to/wechat-platform-public-key.pem
# WECHAT_PAY_PLATFORM_SERIAL=PUB_KEY_ID_or_platform_certificate_serial
# WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/v1/wechat/notify

# OSS 连接信息可在后台填写；以下环境变量仅供旧配置或自动化部署使用。
# 对每个 storage_providers.id 配一组环境变量，ID 使用大写字母、数字和下划线。
# STORAGE_MY_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_MY_OSS_BUCKET=my-bucket
# STORAGE_MY_OSS_REGION=oss-cn-hangzhou
# STORAGE_MY_OSS_ACCESS_KEY=...
# STORAGE_MY_OSS_SECRET_KEY=...
