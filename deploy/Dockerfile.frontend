# 生产制品由 TanStack Start / Nitro 构建，容器不运行 Vite 开发服务器。
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install --global npm@11.11.0 && npm ci
COPY frontend ./
ENV API_INTERNAL_URL=http://api:3001
RUN npm run generate-routes && npx oxfmt --ignore-path /dev/null src/routeTree.gen.ts && npm run check && npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build --chown=node:node /app/.output ./.output
COPY docs/third-party-notices.md ./THIRD-PARTY-NOTICES.md
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 API_INTERNAL_URL=http://api:3001
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
